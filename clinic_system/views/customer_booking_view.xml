<odoo>
    <record id="customer_booking_form" model="ir.ui.view">
        <field name="name">customer.booking.form</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <form string="Client Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="text-info"
                        invisible="state == 'confirm'"
                        groups="clinic_system.group_confirm_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="o_employee_avatar m-0 p-0">
                        <field name="image" widget="image" class="oe_avatar m-0"/>
                    </div>

                    <div class="oe_title mb24">
                        <h1><field name="name" readonly="1" nolabel="1"/></h1>
                    </div>
                    <group>
                        <group name="group_left">
                            <field name="partner_id" readonly="state=='confirm'" options='{"no_open": True, "no_create": True,"no_create_edit":True}'/>
                            <!--<field name="phone" readonly="state in ['confirm','draft']"/>-->
                            <!--<field name="phone" readonly="state not in ['confirm','draft']"/>-->
                            <!--<field name="phone" readonly="state != ['confirm','draft']"/>-->
                            <field name="client_name" invisible="1"/>
                            <field name="phone" readonly="state in ['confirm']"/>
                            <field name="number_of_people" readonly="1"/>
                            <field name="company_id"/>
                        </group>
                        <group name="group_right">
                            <field name="date" string="Booking Date"/>
                            <field name="booking_time"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="pdf_file"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="line">
                            <field name="booking_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="total_price"/>
                                </tree>
                            </field>
                            <div name="total">
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="total_amount"/>
                                </group>
                            </div>
                        </page>
                        <page string="Note" name="line">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="customer_booking_tree" model="ir.ui.view">
        <field name="name">customer.booking.tree</field>
        <field name="model">customer.booking</field>
        <field name="arch" type="xml">
            <tree string="Client Booking">
                <field name="name"/>
                <field name="client_name"/>
                <field name="phone"/>
                <field name="date" string="Booking Date"/>
                <field name="booking_time"/>
            </tree>
        </field>
    </record>

    <record id="action_client_booking" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="res_model">customer.booking</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_clinic_system"
              name="Clinic System"
              sequence="5"
    />

    <menuitem id="menu_client_info"
              name ="Client Information"
              sequence="5"
              parent="clinic_system.menu_clinic_system"
    />

    <menuitem id="menu_client_booking"
              name ="Booking"
              sequence="5"
              parent="clinic_system.menu_client_info"
              action="action_client_booking"
    />



</odoo>