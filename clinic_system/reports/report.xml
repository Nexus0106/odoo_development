<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Creating Report-->
    <record id="customer_booking_pdf" model="ir.actions.report">
        <field name="name">Customer Booking A4</field>
        <field name="model">customer.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic_system.report_customer_booking</field>
        <field name="report_file">clinic_system.report_customer_booking</field>
        <field name="print_report_name">'Booking - %s' % (object.name)</field>
        <field name="binding_model_id" ref="clinic_system.model_customer_booking"/>
        <field name="binding_type">report</field>
        <field name="attachment_use" eval="False"/>
    </record>

    <!--Creating Paper Size-->
    <record id="booking_paper_a4" model="report.paperformat">
        <field name="name">A4 Booking PDF</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
        <field name="report_ids" eval="[(6,0,[ref('clinic_system.customer_booking_pdf')])]"/>
    </record>
</odoo>