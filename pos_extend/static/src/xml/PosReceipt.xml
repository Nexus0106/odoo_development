<?xml version="1.0" encoding="UTF-8" ?>
<template id="template" xml:space="preserve">
    <t t-name="pos_extend.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" positon="after">
            <t t-if="props.data.partner">
                <div class="pos-receipt-center-align">
                    <div>Customer : <t t-esc="props.data.partner.name"/></div>
                </div>
            </t>

        </xpath>
    </t>

    <t t-name="pos_extend.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" positon="after">
            <div style="font-weight:bold;text-align:center;">
                You have earned <t t-esc="props.data.loyalty_points"/>
            </div>
        </xpath>
    </t>
</template>