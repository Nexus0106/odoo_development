<odoo>
    <record id="notice_dashboard_from" model="ir.ui.view">
        <field name="name">notice.dashboard.form</field>
        <field name="model">notice.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible ="draft,confirm"/>
                    <button name="action_confirm" string="Confirm" class="btn-success" type="object" invisible="state!='draft'"/>
                    <button name="action_reset_to_draft" string="Reset To Draft" class="btn-primary" type="object" invisible="state!='confirm'"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" nolabel="1" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="notice_dashboard_tree" model="ir.ui.view">
        <field name="name">notice.dashboard.tree</field>
        <field name="model">notice.dashboard</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="action_notice_dashboard" model="ir.actions.act_window">
        <field name="name">Notice Dashboard</field>
        <field name="res_model">notice.dashboard</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_notice_dashboard"
              name="Notice Dashboard"
              action="action_notice_dashboard"
              sequence="25"
              parent="website.menu_website_global_configuration"/>
</odoo>