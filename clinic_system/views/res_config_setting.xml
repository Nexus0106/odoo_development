<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_form_inherit" model="ir.ui.view">
        <field name="name">res.config.setting.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="after">
                <block title="Limit Amount" id="limit_amount">
                    <setting>
                        <field name="limit_amount" placeholder="2000.00"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>